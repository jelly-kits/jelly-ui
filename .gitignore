# 依赖
node_modules/

# 构建产物（vite / vue-tsc 生成，勿手改）
dist/
# 文档站产物（npm run build:demo）
dist-demo/
*.tsbuildinfo

# uni-app 版组件库：作为独立仓库 jelly-kits/jelly-ui-uniapp 维护，不纳入本仓库跟踪。
# 它将来会自己 git init；届时若不被忽略，外层 git add 会把它当成嵌套仓库记成 gitlink。
uni/

# 缓存
.vite/
node_modules/.vite/
coverage/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量（本地覆盖，勿提交）
.env
.env.*.local
*.local

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 无头验证用临时探针页（用完即删）
_probe*.html

# 一次性迁移脚本目录（跑完即删，产物已入库）
.tmp-gen/

# 构建期临时目录（本地把 TEMP/TMP 指到这里，避免污染系统盘）
.tmp-esbuild/
